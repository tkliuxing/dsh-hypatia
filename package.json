{
  "name": "@tkliuxing/dsh-hypatia",
  "version": "0.2.0",
  "description": "Long-term memory for DeepSeek Harness backed by Hypatia: a host-side CLI adapter, a plugin-owned SQLite control ledger, same-request recall, and narrow memory tools. Requires the `hypatia` CLI on PATH.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkliuxing/dsh-hypatia.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "hypatia",
    "memory",
    "knowledge-graph"
  ],
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "skills",
    "GOAL.md",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test 'tests/**/*.spec.js'",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench-recall.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
